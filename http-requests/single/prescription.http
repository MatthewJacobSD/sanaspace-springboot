### PATCH prescription
PATCH {{host}}/api/prescriptions/{{id}}
Content-Type: {{contentType}}

{
  "prescriptionDate": "2025-06-01",
  "dosageAmount": 250,
  "duration": 5,
  "comment": "Adjusted to 250mg daily for pain management"
}

### PUT prescription
PUT {{host}}/api/prescriptions/{{id}}
Content-Type: {{contentType}}

{
  "prescriptionDate": "2025-06-05",
  "dosageAmount": 500,
  "duration": 7,
  "comment": "Take 500mg twice daily for pain relief",
  "doctor": {
    "id": "{{doctorId}}"
  },
  "medication": {
    "id": "{{medicationId}}"
  },
  "patient": {
    "id": "{{patientId}}"
  }
}

### DELETE prescription
DELETE {{host}}/api/prescriptions/{{id}}