### ~~~~~~~~~~~~~~~~~~~~~~~~~~~
### PATIENT ENDPOINTS
### ~~~~~~~~~~~~~~~~~~~~~~~~~~~

### GET all patients
GET {{host}}/api/patients

### GET patient by ID
@patientId = 
GET {{host}}/api/patients/{{patientId}}

### POST new patient
POST {{host}}/api/patients
Content-Type: {{contentType}}

{
  "firstname": "Joe",
  "lastname": "Doe",
  "address": "clueless john street 89",
  "email": "joedoe@xample.com",
  "postcode": "hw2 kdf3",
  "phoneNo": "123-456-6789"
}

### PATCH patient
PATCH {{host}}/api/patients/{{patientId}}
Content-Type: {{contentType}}

{
  "firstname": "Micheal",
  "lastname": "Smith",
  "address": "where is jow doe street 30",
  "email": "mith@xample.com"
}

### PUT patient
PUT {{host}}/api/patients/{{patientId}}
Content-Type: {{contentType}}

{
  "firstname": "JDerek",
  "lastname": "Doeol",
  "address": "why joe ate my biscuit street 89",
  "email": "noderek@xample.com",
  "postcode": "24j lkn25",
  "phoneNo": "012-653-1564",
  "insurance": {
    "id": "{{insuranceId}}"
  }
}

### DELETE patient
DELETE {{host}}/api/patients/{{patientId}}

### ~~~~~~~~~~~~~~~~~~~~~~~~~~~
### PRESCRIPTION ENDPOINTS
### ~~~~~~~~~~~~~~~~~~~~~~~~~~~

### GET all prescriptions
GET {{host}}/api/prescriptions

### GET prescription by ID
@prescriptionId = 
GET {{host}}/api/prescriptions/{{prescriptionId}}

### POST new prescription
POST {{host}}/api/prescriptions
Content-Type: {{contentType}}

{
  "prescriptionDate": "2022-07-14",
  "dosage": 35,
  "duration": 1,
  "comment": "im sick",
  "doctor": {
    "id": "{{doctorId}}"
  },
  "medication": {
    "id": "{{medicationId}}"
  },
  "patient": {
    "id": "{{patientId}}"
  }
}

### PATCH prescription
PATCH {{host}}/api/prescriptions/{{prescriptionId}}
Content-Type: {{contentType}}

{
  "prescriptionDate": "2022-08-30",
  "dosage": 15,
  "duration": 10,
  "comment": "not feeling well, trying to but nothing works"
}

### PUT prescription
PUT {{host}}/api/prescriptions/{{prescriptionId}}
Content-Type: {{contentType}}

{
  "prescriptionDate": "2023-01-20",
  "dosage": 15,
  "duration": 10,
  "comment": "not feeling well, trying to but nothing works",
  "doctor": {
    "id": "{{doctorId}}"
  },
  "medication": {
    "id": "{{medicationId}}"
  },
  "patient": {
    "id": "{{patientId}}"
  }
}

### DELETE prescription
DELETE {{host}}/api/prescriptions/{{prescriptionId}}

### ~~~~~~~~~~~~~~~~~~~~~~~~~~~
### VISIT ENDPOINTS
### ~~~~~~~~~~~~~~~~~~~~~~~~~~~

### GET all visits
GET {{host}}/api/visits

### GET visit by composite ID
@visitDate = 2025-08-08
GET {{host}}/api/visits/{{patientId}}/{{doctorId}}/{{visitDate}}

### POST new visit
POST {{host}}/api/visits
Content-Type: {{contentType}}

{
  "id": {
    "patientId": "{{patientId}}",
    "doctorId": "{{doctorId}}",
    "visitDate": "{{visitDate}}"
  },
  "symptoms": "flu",
  "diagnosis": "fever"
}

### PATCH visit
PATCH {{host}}/api/visits/{{patientId}}/{{doctorId}}/{{visitDate}}
Content-Type: {{contentType}}

{
  "symptoms": "fever and cough",
  "diagnosis": "flu"
}

### PUT visit
PUT {{host}}/api/visits/{{patientId}}/{{doctorId}}/{{visitDate}}
Content-Type: {{contentType}}

{
  "symptoms": "headache",
  "diagnosis": "cold"
}

### DELETE visit
DELETE {{host}}/api/visits/{{patientId}}/{{doctorId}}/{{visitDate}}