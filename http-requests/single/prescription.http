@host = http://localhost:8080
@contentType = application/json

### GET all prescriptions (starts from 1)
GET {{host}}/api/prescriptions?page=1&size=10

### GET prescription by ID
@id = bc74230c-a3a4-4005-805e-af79b7d26e85
@doctorId = 13c70af8-7676-45df-a2ec-252a03424849
@medicationId = a2c8b37e-7ec6-47af-b9e6-11acd3b2b7ea
@patientId = 3f2ae8df-b178-44c1-a086-425a6efce818
GET {{host}}/api/prescriptions/{{id}}

### POST new prescription (Original, Updated)
POST {{host}}/api/prescriptions
Content-Type: {{contentType}}

{
  "prescriptionDate": "2025-05-20",
  "dosage": 50,
  "duration": 7,
  "comments": "Take 500mg twice daily for pain relief",
  "doctor": {
    "id": "{{doctorId}}"
  },
  "medication": {
    "id": "{{medicationId}}"
  },
  "patient": {
    "id": "{{patientId}}"
  }
}

