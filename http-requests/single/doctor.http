@host = http://localhost:8080
@contentType = application/json

### GET all doctors
GET {{host}}/api/doctors

### GET doctor by ID
@id = ff7c0432-89ab-40c5-bc50-f6b77439d9c6 
GET {{host}}/api/doctors/{{id}}

### POST new doctor (Original)
POST {{host}}/api/doctors
Content-Type: {{contentType}}

{
  "firstName": "Joe",
  "lastName": "Doe",
  "address": "13 Clueless Area, Springfield",
  "email": "joedoe@example.com",
  "experience": "JUNIOR"
}

