@host = http://localhost:8080
@contentType = application/json

### GET all doctors(starts from 1 page)
GET {{host}}/api/doctors?page=1&size=10

### GET doctor by ID
@id = 13c70af8-7676-45df-a2ec-252a03424849
GET {{host}}/api/doctors/{{id}}

### POST new doctor (Original)
POST {{host}}/api/doctors
Content-Type: {{contentType}}

{
  "firstName": "Joe",
  "lastName": "Doe",
  "address": "13 Clueless Area, Springfield",
  "email": "joedoe@example.com",
  "experience": "Junior"
}

