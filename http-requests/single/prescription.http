@host = http://localhost:8080
@contentType = application/json

### GET all prescriptions
GET {{host}}/api/prescriptions

### GET prescription by ID
@id = 9334f375-89cd-4a5c-97c5-0ab725a72bf9
@doctorId = ff7c0432-89ab-40c5-bc50-f6b77439d9c6
@medicationId = 326cc44c-2456-4c30-b7fb-53f7c7a78d52
@patientId = 87af4083-c998-42c6-81c5-2c0b6e7b50ae
GET {{host}}/api/prescriptions/{{id}}

### POST new prescription (Original, Updated)
POST {{host}}/api/prescriptions
Content-Type: {{contentType}}

{
  "prescriptionDate": "2025-05-20",
  "dosageAmount": 500,
  "duration": 7,
  "comment": "Take 500mg twice daily for pain relief",
  "doctor": {
    "id": "{{doctorId}}"
  },
  "medication": {
    "id": "{{medicationId}}"
  },
  "patient": {
    "id": "{{patientId}}"
  }
}

