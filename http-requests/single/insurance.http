@host = http://localhost:8080
@contentType = application/json

### GET all insurances
GET {{host}}/api/insurances

### GET insurance by ID
@id = 
GET {{host}}/api/insurances/{{id}}

### POST new insurance (Original)
POST {{host}}/api/insurances
Content-Type: {{contentType}}

{
  "companyName": "Nescol Insurance",
  "address": "28 Nescol Street, Aberdeen, AB10 1YL",
  "phoneNumber": "012-345-6789"
}

