@host = http://localhost:8080
@contentType = application/json

### GET all insurances(starts from 1 page)
GET {{host}}/api/insurances?page=1&size=10

### GET insurance by ID 
@id = 21fd58b9-6873-4f12-b4c0-877cb5e78ec1
GET {{host}}/api/insurances/{{id}}

### POST new insurance (Original)
POST {{host}}/api/insurances
Content-Type: {{contentType}}

{
  "companyName": "Nescol Insurance",
  "address": "28 Nescol Street, Aberdeen, AB10 1YL",
  "phoneNumber": "0123456789"
}

