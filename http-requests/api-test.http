@host = http://localhost:8080
@contentType = application/json

### ~~~~~~~~~~~~~~~~~~~~~~~~~~~
### DOCTOR ENDPOINTS
### ~~~~~~~~~~~~~~~~~~~~~~~~~~~

### GET all doctors
GET {{host}}/api/doctors

### GET doctor by ID
@doctorId =
GET {{host}}/api/doctors/{{doctorId}}

### POST new doctor
POST {{host}}/api/doctors
Content-Type: {{contentType}}

{
  "firstname": "Joe",
  "lastname": "Doe",
  "address": "john smith clueless area 13",
  "email": "joedoe@xample.com",
  "specialization": "General",
  "experience": "intermediate"
}

### PATCH doctor
PATCH {{host}}/api/doctors/{{doctorId}}
Content-Type: {{contentType}}

{
  "firstname": "William",
  "email": "williamhello@xample.com"
}

### PUT doctor
PUT {{host}}/api/doctors/{{doctorId}}
Content-Type: {{contentType}}

{
  "firstname": "Micheal",
  "lastname": "Smith",
  "address": "where is jow doe street 30",
  "email": "mith@xample.com",
  "specialization": "Oncologists",
  "experience": "intermediate"
}

### DELETE doctor
DELETE {{host}}/api/doctors/{{doctorId}}

### ~~~~~~~~~~~~~~~~~~~~~~~~~~~
### MEDICATIONS ENDPOINTS
### ~~~~~~~~~~~~~~~~~~~~~~~~~~~

### GET all medications
GET {{host}}/api/medications

### GET medication by ID
@medicationId = 
GET {{host}}/api/medications/{{medicationId}}

### POST new medication
POST {{host}}/api/medications
Content-Type: {{contentType}}

{
  "name": "paracetamol",
  "sideEffects": "addiction to its good taste",
  "benefits": "relieve pain and headache"
}

### PATCH medication
PATCH {{host}}/api/medications/{{medicationId}}
Content-Type: {{contentType}}

{
  "sideEffects": "dangerous if eaten without a cause"
}

### PUT medication
PUT {{host}}/api/medications/{{medicationId}}
Content-Type: {{contentType}}

{
  "name": "tachipirina",
  "sideEffects": "addiction to its good taste",
  "benefits": "relieve pain and headache"
}

### DELETE medication
DELETE {{host}}/api/medications/{{medicationId}}

