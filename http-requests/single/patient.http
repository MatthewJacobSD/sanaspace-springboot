### PATCH patient
PATCH {{host}}/api/patients/{{id}}
Content-Type: {{contentType}}

{
  "firstName": "Michael",
  "lastName": "Smith",
  "address": "30 Joe Doe Street, Chicago, IL 60601",
  "email": "michael.smith@example.com"
}

### PUT patient
PUT {{host}}/api/patients/{{id}}
Content-Type: {{contentType}}

{
  "firstName": "Derek",
  "lastName": "Doe",
  "address": "89 Biscuit Street, Springfield, IL 62701",
  "email": "derek.doe@example.com",
  "postcode": "62701",
  "phoneNumber": "012-653-1564",
  "insurance": {
    "id": "{{insuranceId}}"
  }
}

### DELETE patient
DELETE {{host}}/api/patients/{{id}}