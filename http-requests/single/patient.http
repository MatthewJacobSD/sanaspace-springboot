@host = http://localhost:8080
@contentType = application/json

### GET all patients(starts from 1)
GET {{host}}/api/patients?page=1&size=10

### GET patient by ID
@id = 3f2ae8df-b178-44c1-a086-425a6efce818
@insuranceId = 21fd58b9-6873-4f12-b4c0-877cb5e78ec1 
GET {{host}}/api/patients/{{id}}

### POST new patient (Original, Updated)
POST {{host}}/api/patients
Content-Type: {{contentType}}

{
  "firstName": "Joe",
  "lastName": "Doe",
  "address": "89 John Street, Springfield, IL 62701",
  "email": "joedoe@example.com",
  "postcode": "62701",
  "phoneNumber": "1234567890"
}

### POST new patient (Test Case 1)
POST {{host}}/api/patients
Content-Type: {{contentType}}

{
  "firstName": "Emma",
  "lastName": "Rodriguez",
  "address": "245 Maple Avenue, Boston, MA 02118",
  "email": "emma.rodriguez@healthmail.com",
