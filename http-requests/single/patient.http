@host = http://localhost:8080
@contentType = application/json

### GET all patients
GET {{host}}/api/patients

### GET patient by ID
@id = 87af4083-c998-42c6-81c5-2c0b6e7b50ae
@insuranceId = c67cf990-9346-4ed6-a865-459736c9ff8b
GET {{host}}/api/patients/{{id}}

### POST new patient (Original, Updated)
POST {{host}}/api/patients
Content-Type: {{contentType}}

{
  "firstName": "Joe",
  "lastName": "Doe",
  "address": "89 John Street, Springfield, IL 62701",
  "email": "joedoe@example.com",
  "postcode": "62701",
  "phoneNumber": "123-456-7890"
}

